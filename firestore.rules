rules_version = '2';

// Paste this into: Firebase Console -> Firestore Database -> Rules -> Publish.
//
// Restricted to one specific UID rather than just "any signed-in user" --
// Firebase's email/password provider allows public self-registration
// against the project's (necessarily public) client API key, so "signed in"
// alone doesn't mean "is the intended owner." A UID isn't sensitive (safe to
// have in this public file, same as the API key), so hardcoding it here is
// what actually closes that gap: even if a stranger self-registers a new
// account elsewhere, their UID won't match and every rule below denies them.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'IrzS1lIatCTJhovT7trJBFAXhND2';
    }

    match /inventory/{itemId} {
      allow read, write: if isOwner();
    }
    match /sales/{saleId} {
      allow read, write: if isOwner();
    }
  }
}
